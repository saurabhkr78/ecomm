      "seed": 76992770,
      "version": 211,
      "versionNonce": 1527283422,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1757441844567,
      "link": null,
      "locked": false,
      "text": "Technology Choice:\n   what to choose?\n    Severless or server? serverbase: i will explain later why i choose by considering both the pros and cons of serverless and serverbase.\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Technology Choice:\n   what to choose?\n    Severless or server? serverbase: i will explain later why i choose by considering both the pros and cons of serverless and serverbase.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
